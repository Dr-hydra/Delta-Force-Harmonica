<Application x:Class="DFH.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:DFH.Desktop.Infrastructure"
             StartupUri="Views/MainWindow.xaml"
             ThemeMode="System">
    <Application.Resources>
        <!-- Tactical yellow-green accent shared with the web app. -->
        <SolidColorBrush x:Key="DfhAccentBrush" Color="#C8D93A" />
        <SolidColorBrush x:Key="DfhAccentTextBrush" Color="#1B1F0A" />
        <SolidColorBrush x:Key="DfhChipBrush" Color="#14808080" />
        <SolidColorBrush x:Key="DfhChipBorderBrush" Color="#33808080" />
        <SolidColorBrush x:Key="DfhMutedBrush" Color="#99808080" />
        <SolidColorBrush x:Key="DfhWarnBrush" Color="#E0A030" />
        <SolidColorBrush x:Key="DfhDangerBrush" Color="#D9534F" />

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <infra:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <infra:TabVisibilityConverter x:Key="TabVisibility" />
        <infra:TabSelectedConverter x:Key="TabSelected" />

        <Style x:Key="NavButton" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="14" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource DfhAccentBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource DfhAccentTextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DfhMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Application.Resources>
</Application>
