<Window x:Class="DFH.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DFH.Desktop.Views"
        xmlns:vm="clr-namespace:DFH.Desktop.ViewModels"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="三角洲口琴 · 自动演奏 / 手动可视化"
        Width="1180" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Command="{Binding OpenWebsiteCommand}" Content="打开网页版 ↗" Padding="12,6" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="口琴演奏器" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0"/>
                <RadioButton Style="{StaticResource NavButton}" Content="演奏" GroupName="workspace"
                    IsChecked="{Binding IsPerformancePage, Mode=TwoWay}"/>
                <RadioButton Style="{StaticResource NavButton}" Content="设置" GroupName="workspace"
                    IsChecked="{Binding IsSettingsPage, Mode=TwoWay}"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Visibility="{Binding IsPerformancePage, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelCard}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="14,12,14,0">
                        <RadioButton Style="{StaticResource NavButton}" Content="本地曲库" GroupName="nav"
                            IsChecked="{Binding SelectedTab, Converter={StaticResource TabSelected}, ConverterParameter=0, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="公开曲库" GroupName="nav"
                            IsChecked="{Binding SelectedTab, Converter={StaticResource TabSelected}, ConverterParameter=1, Mode=TwoWay}"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <views:LocalPage Visibility="{Binding SelectedTab, Converter={StaticResource TabVisibility}, ConverterParameter=0}"/>
                        <views:LibraryPage DataContext="{Binding Library}"
                            Visibility="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TabVisibility}, ConverterParameter=1}"/>
                    </Grid>
                </Grid>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Style="{StaticResource PanelCard}" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}" Text="演奏模式"/>
                        <WrapPanel IsEnabled="{Binding CanChangeMode}">
                            <RadioButton Content="普通模式" GroupName="experience" Style="{StaticResource NavButton}" IsChecked="{Binding ExperienceMode, Converter={StaticResource TabSelected}, ConverterParameter=0, Mode=TwoWay}"/>
                            <RadioButton Content="练习模式" GroupName="experience" Style="{StaticResource NavButton}" IsChecked="{Binding ExperienceMode, Converter={StaticResource TabSelected}, ConverterParameter=1, Mode=TwoWay}"/>
                            <RadioButton Content="计分模式" GroupName="experience" Style="{StaticResource NavButton}" IsChecked="{Binding ExperienceMode, Converter={StaticResource TabSelected}, ConverterParameter=2, Mode=TwoWay}"/>
                            <RadioButton Content="自动演奏" GroupName="experience" Style="{StaticResource NavButton}" IsChecked="{Binding ExperienceMode, Converter={StaticResource TabSelected}, ConverterParameter=3, Mode=TwoWay}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding ModeDescription}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource PanelCard}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Padding="8,3" Margin="10,0,0,0" CornerRadius="4" Background="{StaticResource DfhWarnBrush}"
                                Visibility="{Binding IsLegacy, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="旧版导出" Foreground="{StaticResource DfhAccentTextBrush}"/>
                            </Border>
                            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Style="{StaticResource Muted}" Text="{Binding Score.Summary}" Margin="0,6,0,12"/>
                        <views:ScoreView Grid.Row="2" DataContext="{Binding Score}"/>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource PanelCard}" Padding="14" Margin="0,10,0,0"
                    Visibility="{Binding PracticeEnabled, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PracticeFeedback}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Eyebrow}" Text="实时成绩"/>
                        </DockPanel>
                        <TextBlock Text="{Binding PracticeSummary}" TextWrapping="Wrap"/>
                        <Expander Header="误差与反应时间" Margin="0,8,0,0">
                            <TextBlock Text="{Binding PracticeTiming}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                        </Expander>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource PanelCard}" Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVisibility}}">
            <views:SettingsPage DataContext="{Binding Settings}"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PanelCard}" Padding="14,10" Margin="0,14,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource DfhAccentBrush}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StateLabel}" Foreground="{StaticResource DfhAccentTextBrush}" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding ElapsedLabel}" Style="{StaticResource Mono}" VerticalAlignment="Center"/>
                </Grid>
                <ProgressBar Height="5" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,0,0,10"/>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="悬浮窗" Command="{Binding ShowOverlayCommand}" ToolTip="{Binding OverlayButtonLabel}" Padding="12,6" Margin="8,0,0,0"/>
                        <Button Content="键盘调整" Command="{Binding AdjustOverlayCommand}" ToolTip="{Binding AdjustOverlayButtonLabel}" Padding="12,6" Margin="8,0,0,0"/>
                        <Button Content="上次结果" Command="{Binding ShowResultCommand}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}" Padding="12,6" Margin="8,0,0,0"/>
                        <Button Content="外观…" Padding="12,6" Margin="8,0,0,0" Click="OpenAppearance"/>
                    </StackPanel>
                    <WrapPanel>
                        <Button Content="{Binding PreviousButtonLabel}" Command="{Binding PreviousCommand}" Padding="10,8" Margin="0,0,8,0"/>
                        <Button Content="{Binding StartButtonLabel}" Command="{Binding StartCommand}" Padding="16,8" Margin="0,0,8,0" FontWeight="SemiBold" Style="{DynamicResource AccentButtonStyle}"/>
                        <Button Content="{Binding PauseButtonLabel}" Command="{Binding PauseCommand}" Padding="10,8" Margin="0,0,8,0"/>
                        <Button Content="{Binding StopButtonLabel}" Command="{Binding StopCommand}" Padding="10,8" Margin="0,0,8,0"/>
                        <Button Content="{Binding NextButtonLabel}" Command="{Binding NextCommand}" Padding="10,8"/>
                    </WrapPanel>
                </DockPanel>
                <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="{Binding PreflightLine}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding PreflightLine}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.RowSpan="3" Panel.ZIndex="20" Background="#99000000"
                Visibility="{Binding ShowResult, Converter={StaticResource BoolToVisibility}}">
            <Border Margin="24" Padding="24" MaxWidth="740" VerticalAlignment="Center" CornerRadius="12"
                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderBrush="{StaticResource DfhChipBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,18">
                        <Button DockPanel.Dock="Right" Content="关闭" Command="{Binding CloseResultCommand}" Padding="12,6"/>
                        <StackPanel>
                            <TextBlock Text="演奏结果" FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding LastResult.Title}" FontSize="16" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding LastResult.Mode}"/>
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding LastResult.Completion}"/>
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="350">
                        <StackPanel>
                            <UniformGrid Columns="3" Margin="0,0,0,18">
                                <StackPanel><TextBlock Text="{Binding LastResult.MainLabel}" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding LastResult.MainValue}" FontSize="30" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel><TextBlock Text="正确 / 命中率" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding LastResult.Accuracy}" FontSize="30" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel><TextBlock Text="最高连击" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding LastResult.Combo}" FontSize="30" FontWeight="SemiBold"/></StackPanel>
                            </UniformGrid>
                            <TextBlock Text="{Binding LastResult.Judgments}" TextWrapping="Wrap" FontSize="15" Margin="0,0,0,18"/>
                            <TextBlock Text="误差 / 反应时间" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding LastResult.Timing}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding LastResult.Samples}" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding LastResult.Summary}" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                    <WrapPanel Grid.Row="2" Margin="0,20,0,0" HorizontalAlignment="Right">
                        <Button Content="返回谱面" Command="{Binding CloseResultCommand}" Padding="16,8" Margin="0,0,8,0"/>
                        <Button Content="开始当前曲" Command="{Binding StartCommand}" Padding="16,8" Style="{DynamicResource AccentButtonStyle}"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
