<UserControl x:Class="DFH.Desktop.Views.LocalPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DFH.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}" Text="本地曲库" />
        <TextBlock Grid.Row="1" Style="{StaticResource Muted}" Text="{Binding LocalLibrary.DirectoryPath}" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding LocalLibrary.DirectoryPath}" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Height="34" Padding="12,0" Content="打开文件夹" Command="{Binding LocalLibrary.OpenFolderCommand}"
                    ToolTip="通过 Windows 桌面外壳打开；适用于本程序以管理员身份运行的情况" />
            <Button Height="34" Padding="12,0" Margin="8,0,0,0" Content="更换文件夹" Command="{Binding LocalLibrary.ChooseFolderCommand}" />
            <Button Height="34" Padding="12,0" Margin="8,0,0,0" Content="刷新" Command="{Binding LocalLibrary.RefreshCommand}" />
            <Button Height="34" Padding="12,0" Margin="8,0,0,0" Content="选择其他 MIDI…" Command="{Binding OpenMidiCommand}" />
        </StackPanel>

        <ListBox Grid.Row="3" Margin="0,10,0,0" ItemsSource="{Binding LocalLibrary.Entries}"
                 SelectedItem="{Binding LocalLibrary.Selected, Mode=TwoWay}" MouseDoubleClick="OnDoubleClick"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding FileName}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding DurationLabel}" VerticalAlignment="Center" TextAlignment="Right" Style="{StaticResource Mono}" />
                        <TextBlock Grid.Column="2" Text="{Binding NoteCount}" VerticalAlignment="Center" TextAlignment="Right" Style="{StaticResource Mono}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Muted}" Text="{Binding LocalLibrary.Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Height="34" Padding="14,0" Content="打开选中" Command="{Binding LocalLibrary.OpenSelectedCommand}" />
        </Grid>

        <TextBlock Grid.Row="5" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="把本站导出的 .mid 放进此文件夹后会自动出现；网页曲库的“下载到本地”也会保存到这里。仍可把 MIDI 直接拖到窗口。" />
    </Grid>
</UserControl>
