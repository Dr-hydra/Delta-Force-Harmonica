<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:DFH.Desktop.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Class="DFH.Desktop.Views.SettingsPage" mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="设置" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource Muted}" Text="按用途分类；修改快捷键或播放参数后，点击底部保存。" Margin="0,6,0,0"/>
        </StackPanel>
        <TabControl Grid.Row="1" SelectedIndex="{Binding DataContext.SettingsSection, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
            <TabItem Header="快捷键">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20" MaxWidth="780" HorizontalAlignment="Stretch">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="热键"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="默认 F5 开始 / 结束、F6 暂停 / 继续、F7 悬浮窗、F8 上一首、F9 下一首、F10 键盘调整。六项可分别选择 F1–F24，保存后立即生效。"/>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,18,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="开始 / 结束"/>
                                <ComboBox ItemsSource="{Binding HotkeyOptions}" SelectedItem="{Binding StartHotkey}" DisplayMemberPath="Label" AutomationProperties.Name="开始 / 结束热键"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="暂停 / 继续"/>
                                <ComboBox ItemsSource="{Binding HotkeyOptions}" SelectedItem="{Binding PauseHotkey}" DisplayMemberPath="Label" AutomationProperties.Name="暂停 / 继续热键"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="隐藏 / 显示悬浮窗"/>
                                <ComboBox ItemsSource="{Binding HotkeyOptions}" SelectedItem="{Binding OverlayHotkey}" DisplayMemberPath="Label" AutomationProperties.Name="悬浮窗热键"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="本地曲库 · 上一首"/>
                                <ComboBox ItemsSource="{Binding HotkeyOptions}" SelectedItem="{Binding PreviousHotkey}" DisplayMemberPath="Label" AutomationProperties.Name="上一首热键"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="本地曲库 · 下一首"/>
                                <ComboBox ItemsSource="{Binding HotkeyOptions}" SelectedItem="{Binding NextHotkey}" DisplayMemberPath="Label" AutomationProperties.Name="下一首热键"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="进入 / 退出悬浮窗键盘调整"/>
                                <ComboBox ItemsSource="{Binding HotkeyOptions}" SelectedItem="{Binding AdjustOverlayHotkey}" DisplayMemberPath="Label" AutomationProperties.Name="悬浮窗键盘调整热键"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" Text="游戏在前台时也可使用热键。设置页在前台编辑时暂不响应热键，可用下方按钮控制播放。"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" Text="暂停保留进度，也可暂停倒计时；结束后再次开始会从头播放。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="播放与时序">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20" MaxWidth="780" HorizontalAlignment="Stretch">
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,22,0,8" Text="播放"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="开始前倒计时（秒）"/>
                        <TextBox Text="{Binding CountdownSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                        <CheckBox Margin="0,12,0,0" IsChecked="{Binding StopWhenForegroundChanges}" Content="前台窗口切换时自动停止（防止按键发到别的程序）"/>
                        <CheckBox Margin="0,8,0,0" IsChecked="{Binding MinimizeOnPlay}" Content="开始演奏时最小化本窗口"/>
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,22,0,8" Text="按键时序"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="游戏按帧采样输入，修饰键、松键、按住之间要留够整帧的余量。三个档位与网页导出面板同名同值：漏音换「稳健」，跟快歌换「极限」。密集乐段里为了保住这些间隔，音符会被推迟而不是挤在一起。"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="档位"/>
                        <ComboBox ItemsSource="{Binding TimingTierOptions}" SelectedItem="{Binding SelectedTimingTier}" DisplayMemberPath="Label"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="修饰键提前按下（毫秒）"/>
                        <TextBox Text="{Binding ModifierLeadMs, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCustomTiming}"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="松键到下一次按下的间隔（毫秒）"/>
                        <TextBox Text="{Binding ReleaseGapMs, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCustomTiming}"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="音键最短按住（毫秒）"/>
                        <TextBox Text="{Binding MinNoteMs, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCustomTiming}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="悬浮窗">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20" MaxWidth="780" HorizontalAlignment="Stretch">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="悬浮窗外观"/>
                        <TextBlock Style="{StaticResource Muted}" Text="外观调整立即生效并自动保存。键盘移动和缩放可在游戏中完成。"/>
                        <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding OverlayBackgroundTransparency, StringFormat=背景透明度 · {0:0}%}"/>
                            <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding OverlayBackgroundTransparency}" AutomationProperties.Name="悬浮窗背景透明度"/>
                            <TextBlock Style="{StaticResource Muted}" Text="0% 不透明，100% 全透明；文字与音符保持清晰。"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding OverlayFlowSpeed, StringFormat=音符流速 · {0:0.0}×}"/>
                            <Slider Minimum="0.5" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding OverlayFlowSpeed}" AutomationProperties.Name="音符流速"/>
                            <TextBlock Style="{StaticResource Muted}" Text="仅改变下落速度，不改变歌曲节奏与到线时刻。"/>
                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="{Binding OverlayButtonLabel}" Command="{Binding ShowOverlayCommand}" Padding="12,6" Margin="0,0,8,0"/>
                                <Button Content="{Binding AdjustOverlayButtonLabel}" Command="{Binding AdjustOverlayCommand}" Padding="12,6"/>
                            </WrapPanel>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,22,0,8" Text="悬浮窗键盘调整"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="进入调整模式后按下列键移动，每次 10 像素，长按可连续调整；按住微调键每次 1 像素，按住缩放键改变宽高，两者可叠加。退出或隐藏悬浮窗时保存。"/>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="向左 / 减小宽度"/>
                                <ComboBox ItemsSource="{Binding AdjustmentKeyOptions}" SelectedItem="{Binding OverlayLeftKey}" DisplayMemberPath="Label" AutomationProperties.Name="悬浮窗向左键"/>
                            </StackPanel>
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="向右 / 增大宽度"/>
                                <ComboBox ItemsSource="{Binding AdjustmentKeyOptions}" SelectedItem="{Binding OverlayRightKey}" DisplayMemberPath="Label" AutomationProperties.Name="悬浮窗向右键"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="向上 / 减小高度"/>
                                <ComboBox ItemsSource="{Binding AdjustmentKeyOptions}" SelectedItem="{Binding OverlayUpKey}" DisplayMemberPath="Label" AutomationProperties.Name="悬浮窗向上键"/>
                            </StackPanel>
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="向下 / 增大高度"/>
                                <ComboBox ItemsSource="{Binding AdjustmentKeyOptions}" SelectedItem="{Binding OverlayDownKey}" DisplayMemberPath="Label" AutomationProperties.Name="悬浮窗向下键"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="微调修饰键"/>
                                <ComboBox ItemsSource="{Binding ModifierOptions}" SelectedItem="{Binding OverlayFineModifier}" DisplayMemberPath="Label" AutomationProperties.Name="悬浮窗微调修饰键"/>
                            </StackPanel>
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="缩放修饰键"/>
                                <ComboBox ItemsSource="{Binding ModifierOptions}" SelectedItem="{Binding OverlayResizeModifier}" DisplayMemberPath="Label" AutomationProperties.Name="悬浮窗缩放修饰键"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" Text="方向键可选箭头或 A–Z。调整模式会拦截所选方向键及修饰键，用完请退出，再使用这些键操作游戏。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="曲库">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20" MaxWidth="780" HorizontalAlignment="Stretch">
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,22,0,8" Text="曲库"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="公开曲库地址"/>
                        <TextBox Text="{Binding StorageBase, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" BorderBrush="{StaticResource DfhChipBorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button MinWidth="110" Height="36" Content="保存设置" Command="{Binding SaveCommand}" FontWeight="SemiBold" Style="{DynamicResource AccentButtonStyle}"/>
                    <Button MinWidth="110" Height="36" Margin="8,0,0,0" Content="恢复默认" Command="{Binding ResetCommand}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Margin="16,0,0,0" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" ToolTip="{Binding SettingsPath}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
